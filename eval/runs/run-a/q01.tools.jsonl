{"tool": "sl_query", "params": {"connectionId": "warehouse", "measures": [{"expr": "count(distinct d2c_orders.order_name)", "name": "order_count"}, {"expr": "count(d2c_orders.hash_key)", "name": "line_count"}], "dimensions": [], "filters": ["d2c_orders.order_date_key >= '2026-08-01'", "d2c_orders.order_date_key < '2026-09-01'", "coalesce(d2c_orders.is_deleted, false) = false"], "segments": [], "order_by": [], "limit": 1000, "include_empty": true, "include": ["sql"]}}
{"tool": "sql_execution", "params": {"connectionId": "warehouse", "sql": "SELECT COUNT(DISTINCT order_name) AS all_orders, COUNT(DISTINCT IF(COALESCE(is_deleted,false)=false, order_name, NULL)) AS live_orders, COUNT(DISTINCT IF(DATE(created_at) BETWEEN '2026-08-01' AND '2026-08-31' AND COALESCE(is_deleted,false)=false, order_name, NULL)) AS live_by_created_at FROM `sahil-devx.dev_dna_silver.d2c_orders` WHERE order_date_key BETWEEN '2026-08-01' AND '2026-08-31'", "maxRows": 1000}}
