{"tool": "discover_data", "params": {"query": "monthly revenue across all channels sales", "limit": 20}}
{"tool": "connection_list", "params": {}}
{"tool": "sl_read_source", "params": {"connectionId": "warehouse", "sourceName": "sales"}}
{"tool": "sl_query", "params": {"connectionId": "warehouse", "measures": ["sales.revenue_inr"], "dimensions": [{"field": "sales.order_date_key", "granularity": "month"}, {"field": "sales.channel_code"}], "filters": ["sales.order_date_key >= '2025-09-01'", "sales.order_date_key < '2026-09-01'"], "segments": [], "order_by": [{"field": "sales.order_date_key", "direction": "asc"}, {"field": "sales.channel_code", "direction": "asc"}], "limit": 1000, "include_empty": true, "include": ["sql"]}}
{"tool": "sl_query", "params": {"connectionId": "warehouse", "measures": [{"expr": "min(sales.order_date_key)", "name": "first_date"}, {"expr": "max(sales.order_date_key)", "name": "last_date"}, "sales.sales_lines"], "dimensions": [], "filters": [], "segments": [], "order_by": [], "limit": 1000, "include_empty": true, "include": []}}
{"tool": "sl_query", "params": {"connectionId": "warehouse", "measures": ["sales.revenue_inr", "sales.sales_lines"], "dimensions": [{"field": "sales.order_date_key", "granularity": "week"}], "filters": ["sales.order_date_key >= '2025-06-01'"], "segments": [], "order_by": [{"field": "sales.order_date_key", "direction": "asc"}], "limit": 1000, "include_empty": true, "include": []}}
